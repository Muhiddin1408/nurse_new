{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/affiliation.resumed.v1.json",
  "title": "affiliation.resumed",
  "description": "To'xtatilgan hamkorlik qayta faollashdi: shu sabab bilan yopilgan slotlar ochiladi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "affiliation.resumed"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "affiliation"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affiliation_id",
        "clinic_id",
        "doctor_id",
        "resumed_by"
      ],
      "properties": {
        "affiliation_id": {
          "type": "string",
          "format": "uuid"
        },
        "clinic_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "resumed_by": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
