{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/review.published.v1.json",
  "title": "review.published",
  "description": "Sharh e'lon qilindi (avto yoki moderator tomonidan).",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "review.published"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "review"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "booking_id",
        "doctor_id",
        "doctor_user_id",
        "rating"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "format": "uuid"
        },
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "rating": {
          "type": "integer"
        }
      }
    }
  }
}
