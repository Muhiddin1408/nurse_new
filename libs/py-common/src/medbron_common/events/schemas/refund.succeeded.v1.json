{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/refund.succeeded.v1.json",
  "title": "refund.succeeded",
  "description": "Pul mijozga qaytarildi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "refund.succeeded"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "refund"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refund_id",
        "payment_id",
        "booking_id",
        "client_id",
        "amount_tiyin",
        "doctor_share_tiyin",
        "reason",
        "source",
        "source_ref",
        "completed_at"
      ],
      "properties": {
        "refund_id": {
          "type": "string",
          "format": "uuid"
        },
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "amount_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "tiyin (1 so'm = 100 tiyin)"
        },
        "doctor_share_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "Shu summaning shifokor ulushi (tiyin) — payment ledger'ida doctor_payable dan yechilgan; billing payout'dan aynan shuni ushlaydi (qayta hisoblamaydi)"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "booking_cancelled",
            "booking_no_show",
            "confirmation_failed",
            "dispute",
            "admin"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
