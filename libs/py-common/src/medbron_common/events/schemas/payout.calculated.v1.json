{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/payout.calculated.v1.json",
  "title": "payout.calculated",
  "description": "Haftalik payout davri hisoblandi (shifokor ko'rib chiqishi mumkin).",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "payout.calculated"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "payout"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payout_id",
        "doctor_id",
        "period_start",
        "period_end",
        "bookings_count",
        "gross_tiyin",
        "platform_fee_tiyin",
        "provider_fee_tiyin",
        "refunds_tiyin",
        "net_tiyin"
      ],
      "properties": {
        "payout_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "bookings_count": {
          "type": "integer"
        },
        "gross_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "tiyin (1 so'm = 100 tiyin)"
        },
        "platform_fee_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "tiyin (1 so'm = 100 tiyin)"
        },
        "provider_fee_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "tiyin (1 so'm = 100 tiyin)"
        },
        "refunds_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "tiyin (1 so'm = 100 tiyin)"
        },
        "net_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "tiyin (1 so'm = 100 tiyin)"
        }
      }
    }
  }
}
