{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/review.submitted.v1.json",
  "title": "review.submitted",
  "description": "Mijoz sharh qoldirdi (avtomatik moderatsiya bayroqlari bilan).",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "review.submitted"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "review"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "booking_id",
        "doctor_id",
        "client_id",
        "rating",
        "flags",
        "status"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "format": "uuid"
        },
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "rating": {
          "type": "integer"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "published"
          ]
        }
      }
    }
  }
}
