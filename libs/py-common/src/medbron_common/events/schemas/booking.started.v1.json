      "const": "booking.started"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "booking"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booking_id",
        "client_id",
        "doctor_id",
        "started_at"
      ],
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
