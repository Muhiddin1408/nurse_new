{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/admin.settings_changed.v1.json",
  "title": "admin.settings_changed",
  "description": "Global sozlamalar o'zgardi — consumerlar lokal keshini tashlaydi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "admin.settings_changed"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "settings"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "version",
        "changed_by"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "integer"
        },
        "changed_by": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
