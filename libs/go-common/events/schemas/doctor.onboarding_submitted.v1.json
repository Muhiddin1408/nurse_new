        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "moderation_due_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
