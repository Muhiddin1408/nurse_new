{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/doctor.onboarding_submitted.v1.json",
  "title": "doctor.onboarding_submitted",
  "description": "Shifokor anketasi va hujjatlari moderatsiyaga yuborildi (SLA 48 soat).",
