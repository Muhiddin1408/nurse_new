{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/user.deactivated.v1.json",
  "title": "user.deactivated",
  "description": "Akkaunt o'chirildi/bloklandi; barcha refresh tokenlar bekor qilindi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "user.deactivated"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "user"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "reason"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "enum": [
            "deletion_requested",
            "blocked_by_admin"
          ]
        }
      }
    }
  }
}
