# pricing-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=pricing-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8108
POSTGRES_HOST_PORT=5408
REDIS_HOST_PORT=6308

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=ba84d0656a39efbc205090cbe17d3d1fc607a813a0d3d4af
REDIS_PASSWORD=9f3936e03ff05170c36f18a14c0b89cce57b9e13e7e9d050
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=f034ec2e8fb3a456970715bdda57e801
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=5a84dc79137c52224498b7f7aaa98adb97b0cd2348247204
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
INTERNAL_TOKEN_BOOKING_SERVICE=f66aa8bb8c06514dcda993fc24d0c15c2c9efdab13979b61

# --- Bog'liqliklar ----------------------------------------------------------------
# Shu servisning INTERNAL_TOKEN i catalog/admin'da INTERNAL_TOKEN_PRICING_SERVICE sifatida turishi shart
CATALOG_SERVICE_URL=http://catalog-service:8080
ADMIN_SERVICE_URL=http://admin-service:8080

# --- Narx ------------------------------------------------------------------------
# Quote Redis'da (booking shu oraliqda commit qiladi)
QUOTE_TTL_SECONDS=600
# commit qilingan, lekin booking.created kelmagan band qilish shuncha daqiqada bo'shaydi
RESERVATION_TTL_MINUTES=15
# Takroriy tashrif chegirmasi oynasi
FOLLOW_UP_WINDOW_DAYS=14
# catalog bookability keshi
DOCTOR_CACHE_SECONDS=60

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
