# dispute-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=dispute-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8113
POSTGRES_HOST_PORT=5413
REDIS_HOST_PORT=6313

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DATABASE_URL=postgresql://dispute_service:change-me@localhost:5413/dispute_service
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=change-me
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=change-me
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
# (hech kim — bu servisning internal API'si yopiq)

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=

# --- Bog'liqliklar (reestr: booking, file; admin — global sozlamalar) ----------
# Shu servisning INTERNAL_TOKEN i har birida INTERNAL_TOKEN_DISPUTE_SERVICE sifatida turishi shart.
BOOKING_SERVICE_URL=http://booking-service:8080
FILE_SERVICE_URL=http://file-service:8080
ADMIN_SERVICE_URL=http://admin-service:8080

# --- Texnik parametrlar (SLA soati — admin-service sozlamasi `sla.dispute_hours`) ---
# Bitta nizoga biriktiriladigan dalil fayllari soni
MAX_EVIDENCE_FILES=10
# SLA buzilishini tekshirish oralig'i, soniya
SLA_CHECK_INTERVAL_SECONDS=900
# Admin ko'rinishidagi dalil havolasi muddati, soniya (file-service: ≤ 300)
EVIDENCE_URL_TTL_SECONDS=300
