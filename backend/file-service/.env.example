# file-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=file-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8104
POSTGRES_HOST_PORT=5404

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DATABASE_URL=postgresql://file_service:change-me@localhost:5404/file_service
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=change-me
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=change-me
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
INTERNAL_TOKEN_CATALOG_SERVICE=change-me
INTERNAL_TOKEN_DISPUTE_SERVICE=change-me
INTERNAL_TOKEN_USER_SERVICE=change-me

# --- S3 obyekt ombori (ADR-0010) ---------------------------------------------------
# Ichki manzil (servis amallari) va public manzil (presigned URL / ommaviy rasm havolasi).
# Prod: public — HTTPS domen (CDN) ortida, masalan https://media.medbron.uz
S3_ENDPOINT_URL=http://medbron-s3:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
# backend/infra/.env dagi S3_FILE_SERVICE_ACCESS_KEY / S3_FILE_SERVICE_SECRET_KEY bilan bir xil
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PUBLIC_BUCKET=public-media
S3_PRIVATE_BUCKET=private-documents
UPLOAD_URL_TTL_SECONDS=600
# Maxfiy hujjat havolasi (≤ 300)
PRIVATE_URL_MAX_TTL_SECONDS=300
UNATTACHED_TTL_HOURS=24
MAX_PENDING_UPLOADS_PER_USER=20
THUMBNAIL_SIZE=256

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
