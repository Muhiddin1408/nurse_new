# analytics-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=analytics-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8115
POSTGRES_HOST_PORT=5415
# ClickHouse (faqat 127.0.0.1; host 9000 — S3'da band)
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9009

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DATABASE_URL=postgresql://analytics_service:change-me@localhost:5415/analytics_service
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# ClickHouse — barcha eventlar (`events_raw`). Konteyner ichida CLICKHOUSE_URL docker-compose.yml da quriladi.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_TIMEOUT_SECONDS=30

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=change-me
# Ingest: navbat `analytics-service.all-events` (`#`); partiya — shuncha xabar yoki shuncha soniya (qaysi oldin)
INGEST_BATCH_SIZE=500
INGEST_FLUSH_SECONDS=2
INGEST_PREFETCH=1000
# ClickHouse yiqilsa partiya qayta yoziladi (1, 2, 4 … shu soniyagacha), xabarlar ack qilinmaydi
INGEST_MAX_BACKOFF_SECONDS=30
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=change-me
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
# (hech kim — bu servisning internal API'si yopiq)

# --- Hisobotlar -------------------------------------------------------------------
REPORT_MAX_DAYS=366

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
