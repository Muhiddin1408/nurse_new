# schedule-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=schedule-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO
HTTP_ADDR=:8080
WORKER_METRICS_ADDR=:9100
SHUTDOWN_TIMEOUT=15s

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8107
POSTGRES_HOST_PORT=5407
REDIS_HOST_PORT=6307

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER ustun keladi.
DATABASE_URL=postgres://schedule_service:change-me@localhost:5407/schedule_service?sslmode=disable

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=change-me
CONSUMER_PREFETCH=20

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
INTERNAL_TOKEN=change-me
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
INTERNAL_TOKEN_BOOKING_SERVICE=change-me

# --- Boshqa servislar (internal API; token — INTERNAL_TOKEN) -------------------
CATALOG_SERVICE_URL=http://catalog-service:8080
ADMIN_SERVICE_URL=http://admin-service:8080

# --- Scheduler (schedule-scheduler konteyneri) --------------------------------
# Slot generatsiyasi har kuni shu soatda (Asia/Tashkent); gorizont — admin `schedule.generation_days_ahead`
GENERATE_HOUR=2
# Muddati o'tgan hold'larni bo'shatish (CAS) — oraliq va bitta tranzaksiyadagi soni
EXPIRE_INTERVAL=1m
EXPIRE_BATCH_SIZE=1000
# Shuncha kundan eski, hech qachon band qilinmagan slotlar o'chiriladi (bron tarixi borlari qoladi)
SLOT_RETENTION_DAYS=90

# --- Kuzatuv -------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
