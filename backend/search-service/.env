# search-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=search-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8114
POSTGRES_HOST_PORT=5414
REDIS_HOST_PORT=6314
# Elasticsearch (faqat 127.0.0.1 ga bind)
ES_HOST_PORT=9200

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=2ac6b82b54806d5318583446d48e1cbe3ad1d0dbd44938ca
REDIS_PASSWORD=6ee4e5149c09e48a5d0e458c4101e77d37b373ef0507939b
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=f034ec2e8fb3a456970715bdda57e801
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=71777c007ad98db3e17b94fec760e083c5f39dfa84e3c055
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
# (hech kim — bu servisning internal API'si yopiq)

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=

# --- Bog'liqliklar (reestr: catalog — faqat reindex va mutaxassisliklar lug'ati) --------------
# Shu servisning INTERNAL_TOKEN i catalog-service'da INTERNAL_TOKEN_SEARCH_SERVICE sifatida turishi shart.
CATALOG_SERVICE_URL=http://catalog-service:8080

# --- Elasticsearch 8 ---------------------------------------------------------------
# Konteyner ichida docker-compose.yml beradi (search-service-elasticsearch); host'dan — localhost:9200
ELASTICSEARCH_URL=http://localhost:9200
# PROD: xpack.security yoqilganda
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT_SECONDS=5
# Heap (dev uchun kichik; prod: RAM'ning ~50%, ≤ 31g)
ES_JAVA_OPTS=-Xms512m -Xmx512m
# Bitta klasterda bir nechta muhit bo'lsa (masalan `stage_`)
INDEX_PREFIX=

# --- Texnik parametrlar ------------------------------------------------------------
REINDEX_PAGE_SIZE=200
REINDEX_STALE_MINUTES=60
# Ommaviy qidiruv javobi Redis keshi, soniya (0 — o'chiq)
SEARCH_CACHE_SECONDS=15
