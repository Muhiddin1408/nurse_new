# auth-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=auth-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8101
POSTGRES_HOST_PORT=5401
REDIS_HOST_PORT=6301

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DATABASE_URL=postgresql://auth_service:change-me@localhost:5401/auth_service
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=change-me
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=change-me
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
# (hech kim — bu servisning internal API'si yopiq)

# --- Tokenlar -----------------------------------------------------------------
# Imzo kaliti: konteynerda JWT_PRIVATE_KEY (base64) — compose secrets/private/auth-service.env dan oladi
# (scripts/gen-jwt-keys.sh yaratadi; bu yerga YOZMANG). Hostdan ishga tushirishda — fayl yo'li:
JWT_PRIVATE_KEY_PATH=/secrets-private/jwt-private.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP -----------------------------------------------------------------------
# HMAC kaliti (local/test dan tashqari MAJBURIY). Generatsiya: openssl rand -hex 32
OTP_HASH_SECRET=change-me
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
OTP_MAX_FAILED_VERIFY_PER_PHONE_HOUR=10
# Faqat SMS_PROVIDER=console va prod bo'lmagan muhitda: kod javobga qo'shiladi (frontend/e2e)
OTP_DEBUG_ECHO=false

# --- SMS (ADR-0004: OTP SMS'ni auth o'zi yuboradi) -------------------------------
# console — faqat logga (prod'da taqiqlangan) | eskiz
SMS_PROVIDER=console
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_TIMEOUT_SECONDS=3

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
