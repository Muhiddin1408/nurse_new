# notification-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=notification-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8105
POSTGRES_HOST_PORT=5405
REDIS_HOST_PORT=6305

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=f634f4da3757ef6dc80bef4ec677cbc58440996b467af4c6
REDIS_PASSWORD=8bc13f8c59cd8cc4385e0afdd730e203aba56d3e6e8c21a5
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=f034ec2e8fb3a456970715bdda57e801
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=b84821026168209dad514726082abf183109c1aaaa70d2f3
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
# (hech kim — bu servisning internal API'si yopiq)

# --- SMS (Eskiz) ----------------------------------------------------------------
# console — faqat logga (prod'da taqiqlangan) | eskiz
SMS_PROVIDER=console
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_TIMEOUT_SECONDS=5

# --- Push (faqat FCM — Android va iOS FCM orqali) --------------------------------
# console — logga (lokal) | fcm | off. Prod'da console taqiqlangan.
PUSH_PROVIDER=console
# Bo'sh bo'lsa service account JSON'idagi project_id
FCM_PROJECT_ID=
# Service account: FCM_CREDENTIALS_JSON=<base64> ni secrets/private/notification-service.env ga yozing
# (base64 -w0 service-account.json). Hostdan ishga tushirishda — fayl yo'li:
FCM_CREDENTIALS_FILE=

# --- Telegram bot ------------------------------------------------------------------
# Bo'sh bo'lsa Telegram kanali o'chiq (push → SMS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=medbron_bot
# setWebhook(secret_token=...) bilan bir xil. Bo'sh — webhook yopiq (404). openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=811b9230dafe819c674b45326e1861fb36eda58fb4a5da50
# Bog'lash havolasi (HMAC) kaliti — local/test dan tashqari MAJBURIY. openssl rand -hex 32
TELEGRAM_LINK_SECRET=8ced4ea75aeee6d3364dbb3cc24ca160215e5efef7e93574
TELEGRAM_LINK_TTL_SECONDS=900
# Ops ogohlantirishlari chati (refund yiqildi, nizo SLA, reconciliation). Bo'sh — o'chiq
OPS_TELEGRAM_CHAT_ID=

# --- Eslatmalar (0 — o'chiq) --------------------------------------------------------
REMINDER_FIRST_HOURS=24
REMINDER_SECOND_HOURS=2
REVIEW_REQUEST_AFTER_HOURS=2
# Shifokor kunlik digest'i (Asia/Tashkent)
DIGEST_HOUR=7

# --- Dispatcher ---------------------------------------------------------------------
DISPATCH_BATCH_SIZE=100
DISPATCH_INTERVAL_SECONDS=2
DISPATCH_MAX_ATTEMPTS=5
# Admin o'zgartirgan shablon dispatcher'da shuncha soniyagacha eski bo'lishi mumkin
TEMPLATE_CACHE_SECONDS=60

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
