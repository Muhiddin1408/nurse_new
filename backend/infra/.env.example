# backend/infra — umumiy infratuzilma. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Standart parollar YO'Q — hatto dev'da ham (BLUEPRINT 11). Generatsiya: openssl rand -hex 24

# RabbitMQ (host porti 5672 / 15672 — docs/SERVICE_REGISTRY.md 3-bo'lim)
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=
# Erlang cookie — klaster tugunlari autentifikatsiyasi
RABBITMQ_ERLANG_COOKIE=

# S3 obyekt ombori (SeaweedFS, ADR-0010). Admin — faqat ops; file-service o'z kaliti bilan
# (backend/file-service/.env dagi S3_ACCESS_KEY / S3_SECRET_KEY bilan BIR XIL bo'lishi shart).
S3_ADMIN_ACCESS_KEY=medbron-admin
S3_ADMIN_SECRET_KEY=
S3_FILE_SERVICE_ACCESS_KEY=file-service
S3_FILE_SERVICE_SECRET_KEY=

# Grafana admin
GRAFANA_ADMIN_PASSWORD=

LOG_LEVEL=INFO
