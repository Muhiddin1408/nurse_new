# dlx-bootstrap: libs/py-common dagi declare_topology() ni ishga tushiradi.
# Build konteksti — repo ildizi:  docker build -f backend/infra/Dockerfile.bootstrap .
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /build
COPY libs/py-common /build/libs/py-common
RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache /build/libs/py-common

FROM python:3.12-slim
RUN useradd --system --uid 10001 --no-create-home app
COPY --from=build /opt/venv /opt/venv
COPY backend/infra/eventbus_topology.py /app/eventbus_topology.py
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
USER app
WORKDIR /app
CMD ["python", "eventbus_topology.py"]
