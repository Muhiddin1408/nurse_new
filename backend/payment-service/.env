# payment-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=payment-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8110
POSTGRES_HOST_PORT=5410
REDIS_HOST_PORT=6310

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=48200fc89d1a099e8c5ff7e55ca37a2e456247975c655368
REDIS_PASSWORD=ac6165f7c0b422754179e9aa4e309a1442e51eda3bc59045
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=f034ec2e8fb3a456970715bdda57e801
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=348c151bbb3df02222717f5773d80f5157d441736292eee8
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
# (hech kim — bu servisning internal API'si yopiq)

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=

# --- Bog'liqliklar (reestr: booking, admin) ------------------------------------
# Shu servisning INTERNAL_TOKEN i har birida INTERNAL_TOKEN_PAYMENT_SERVICE sifatida turishi shart.
BOOKING_SERVICE_URL=http://booking-service:8080
ADMIN_SERVICE_URL=http://admin-service:8080

# --- Payme Merchant API --------------------------------------------------------
# Kabinetdagi kassa ID va kalit. Kalit BO'SH bo'lsa webhook HAR so'rovni rad etadi (fail-closed).
PAYME_MERCHANT_ID=dev-merchant
PAYME_SECRET_KEY=aa7789daa528052626458b479b241642258500b09b251811
# Test muhiti: https://test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Vergul bilan; bo'sh — o'chiq (prod'da Payme'ning rasmiy IP ro'yxati; Kong ham tekshiradi)
PAYME_ALLOWED_IPS=
# Protokol: tranzaksiya 12 soatda eskiradi
PAYME_TRANSACTION_TIMEOUT_HOURS=12

# --- Click SHOP API + Merchant API ---------------------------------------------
CLICK_SERVICE_ID=777
CLICK_MERCHANT_ID=42
# Merchant API (reversal, fiskal chek) — bo'sh bo'lsa refund qo'lda (manual_required)
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=5ccbe9d98225204018ebb8097a85a1a78400cef34c4544c1
CLICK_API_URL=https://api.click.uz/v2/merchant
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
CLICK_ALLOWED_IPS=

# --- Texnik parametrlar ----------------------------------------------------------
WEBHOOK_MAX_BODY_BYTES=65536
PROVIDER_CONNECT_TIMEOUT=3
PROVIDER_READ_TIMEOUT=10
# Vaqtinchalik xatoda refund shuncha urinishdan keyin failed + refund.failed (alert)
REFUND_MAX_ATTEMPTS=5
# Provayder so'rov/javob jurnali (nizoda dalil) saqlanish muddati
PROVIDER_LOG_RETENTION_DAYS=365
