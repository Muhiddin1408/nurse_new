# user-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=user-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8102
POSTGRES_HOST_PORT=5402
REDIS_HOST_PORT=6302

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=4774e3b201fae34af103de1a8e021f6e1a49e18fbfbbc4c7
REDIS_PASSWORD=6cb59e4fb0843ea40035c654ba7bc21f20b4886babd188ff
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=f034ec2e8fb3a456970715bdda57e801
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=126db86ffae44e0da48ec854ef8f49336f9656b5c4bdc74c
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
INTERNAL_TOKEN_BOOKING_SERVICE=f66aa8bb8c06514dcda993fc24d0c15c2c9efdab13979b61

# --- Bog'liqliklar ----------------------------------------------------------------
# file-service (avatar biriktirish). Shu servisning INTERNAL_TOKEN i file-service'da
# INTERNAL_TOKEN_USER_SERVICE sifatida turishi shart.
FILE_SERVICE_URL=http://file-service:8080

# --- Chegaralar -----------------------------------------------------------------
MAX_PATIENTS_PER_USER=20
MAX_ADDRESSES_PER_USER=20
MAX_FAVORITES_PER_USER=200

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
