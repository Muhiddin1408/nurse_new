# admin-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=admin-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8103
POSTGRES_HOST_PORT=5403
REDIS_HOST_PORT=6303

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=b7316f88c4dc2d14257ac59a624fe1e36c179871c75cb871
REDIS_PASSWORD=83ba3a81642c5ecd8caad7ad2504b313f44082baada0f837
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=f034ec2e8fb3a456970715bdda57e801
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=9404cf4563c8147ed136a4a5a8dfe1d974ca1907da577b96
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
INTERNAL_TOKEN_BILLING_SERVICE=bee2b9a667dd08a12a1f4d24d59d44d550dcdf144a24f357
INTERNAL_TOKEN_BOOKING_SERVICE=f66aa8bb8c06514dcda993fc24d0c15c2c9efdab13979b61
INTERNAL_TOKEN_DISPUTE_SERVICE=ed068b2a9f2bec89df9af29d94c3de989dfdd82c26c5fb87
INTERNAL_TOKEN_PAYMENT_SERVICE=348c151bbb3df02222717f5773d80f5157d441736292eee8
INTERNAL_TOKEN_PRICING_SERVICE=5a84dc79137c52224498b7f7aaa98adb97b0cd2348247204
INTERNAL_TOKEN_REVIEW_SERVICE=763fa82bfee397bf9a3f4c9fb2e79859af5fc94291f0cd15
INTERNAL_TOKEN_SCHEDULE_SERVICE=9efbc69f0395aaffc20cc2ec01c481f6699a21dd1c49ba25

# --- Admin identity (ADR-0005) --------------------------------------------------
# Imzo kaliti: konteynerda ADMIN_JWT_PRIVATE_KEY (base64) — compose secrets/private/admin-service.env dan oladi
# (scripts/gen-jwt-keys.sh yaratadi; bu yerga YOZMANG). Hostdan ishga tushirishda — fayl yo'li:
ADMIN_JWT_PRIVATE_KEY_PATH=/secrets-private/admin-jwt-private.pem
ADMIN_ACCESS_TOKEN_TTL_SECONDS=1800
# TOTP sirlarini bazada shifrlash kaliti (local/test dan tashqari MAJBURIY). Generatsiya:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ Kalit yo'qolsa — barcha adminlarning TOTP'si qayta o'rnatiladi (app.cli reset-totp).
TOTP_ENCRYPTION_KEY=Vyac7iwGTfsB4vzDh0eFFKtjtAPnkUd-3CtdTywC9FY=
TOTP_ISSUER=MedBron Admin
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_MAX_PER_IP_HOUR=30
MFA_TOKEN_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=12
# /internal/v1/settings javobidagi Cache-Control (chaqiruvchilar keshlaydi)
SETTINGS_CACHE_MAX_AGE_SECONDS=60

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
