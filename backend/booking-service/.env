# booking-service — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=booking-service
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Portlar (reestrdan) -------------------------------------------------------
HOST_PORT=8109
POSTGRES_HOST_PORT=5409
REDIS_HOST_PORT=6309

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
POSTGRES_PASSWORD=a0925785eb8b9cc5a671989577f3b0151896e6d4e0ae881c
REDIS_PASSWORD=9016c4a41899ff018065bbf99de557a07175bdfc419bd527
# Docker'siz (host'dan) ishga tushirish uchun. Konteyner ichida DATABASE_URL_DOCKER
# (docker-compose.yml da quriladi) ustun keladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=f034ec2e8fb3a456970715bdda57e801
CONSUMER_PREFETCH=20
WORKER_METRICS_PORT=9100

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
ADMIN_JWT_PUBLIC_KEY_PATH=/secrets/admin-jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=f66aa8bb8c06514dcda993fc24d0c15c2c9efdab13979b61
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
INTERNAL_TOKEN_DISPUTE_SERVICE=ed068b2a9f2bec89df9af29d94c3de989dfdd82c26c5fb87
INTERNAL_TOKEN_PAYMENT_SERVICE=348c151bbb3df02222717f5773d80f5157d441736292eee8
INTERNAL_TOKEN_REVIEW_SERVICE=763fa82bfee397bf9a3f4c9fb2e79859af5fc94291f0cd15
INTERNAL_TOKEN_WS_GATEWAY=b9cf1e32d406aab764d766b7aace6d0b88ff801e734bf680

# --- Bog'liqliklar (reestr: catalog, schedule, pricing, user, admin) ----------------------
# Shu servisning INTERNAL_TOKEN i har birida INTERNAL_TOKEN_BOOKING_SERVICE sifatida turishi shart.
CATALOG_SERVICE_URL=http://catalog-service:8080
SCHEDULE_SERVICE_URL=http://schedule-service:8080
PRICING_SERVICE_URL=http://pricing-service:8080
USER_SERVICE_URL=http://user-service:8080
ADMIN_SERVICE_URL=http://admin-service:8080

# --- Texnik chegaralar (biznes qoidalari — admin-service global sozlamalarida) -----------
MAX_PENDING_BOOKINGS_PER_CLIENT=3
MAX_RESCHEDULES=2
START_WINDOW_MINUTES=15
AUTO_COMPLETE_AFTER_HOURS=24
PAYMENT_EXTENSION_MINUTES=15
WAITLIST_MAX_NOTIFICATIONS=3
WAITLIST_NOTIFY_COOLDOWN_MINUTES=15

# --- Kuzatuv -------------------------------------------------------------------
# Bo'sh bo'lsa tracing o'chiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
SENTRY_DSN=
