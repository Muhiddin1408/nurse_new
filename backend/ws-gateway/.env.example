# ws-gateway — BARCHA o'zgaruvchilar. Nusxa: cp .env.example .env (`.env` commit QILINMAYDI).
# Qiymatlar docs/SERVICE_REGISTRY.md ga mos bo'lishi shart (CI: scripts/check-registry.py).
# `change-me` — haqiqiy sir emas; generatsiya: openssl rand -hex 24

SERVICE_NAME=ws-gateway
# local | test | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO
HTTP_ADDR=:8080
WORKER_METRICS_ADDR=:9100
SHUTDOWN_TIMEOUT=15s

# --- Portlar (reestrdan; Postgres yo'q) ----------------------------------------
HOST_PORT=8116
REDIS_HOST_PORT=6316

# --- Image (deploy'da CI commit SHA beradi) -----------------------------------
IMAGE_TAG=local

# --- Ma'lumotlar ---------------------------------------------------------------
REDIS_PASSWORD=change-me

# --- Event bus (backend/infra/.env dagi bilan bir xil) ------------------------
RABBITMQ_USER=medbron
RABBITMQ_PASSWORD=change-me
CONSUMER_PREFETCH=20
# Event takrorini (at-least-once) shu muddat ichida tanib oladi (Redis SET NX)
EVENT_DEDUP_TTL=24h

# --- Auth ----------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
# Shu servis boshqalarni chaqirganda ko'rsatadigan token (qabul qiluvchida INTERNAL_TOKEN_<BU_SERVIS>)
INTERNAL_TOKEN=change-me
# Bu servisni chaqirishga ruxsat etilganlar (har biri o'z tokeni bilan) — reestrdagi ro'yxat:
# (hech kim — bu servisning internal API'si yopiq)

# --- Bog'liqliklar (reestr: booking) -----------------------------------------
# Shu servisning INTERNAL_TOKEN i booking-service'da INTERNAL_TOKEN_WS_GATEWAY sifatida turishi shart.
BOOKING_SERVICE_URL=http://booking-service:8080
# `booking:<id>` obuna huquqi (booking /authz) keshi
AUTHZ_CACHE_TTL=60s

# --- WebSocket -------------------------------------------------------------------
# Brauzer Origin'lari (vergul bilan). Origin'siz klient (mobil ilova) — token yetarli.
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bitta foydalanuvchining shu nusxadagi ulanishlari (oshsa — 429)
WS_MAX_CONNS_PER_USER=5
# Bitta ulanishdagi obunalar (booking:<id>, doctor:<id>:schedule)
WS_MAX_SUBSCRIPTIONS=50
# Yuborish navbati; to'lsa — sekin klient 4008 bilan uziladi
WS_SEND_BUFFER=64
WS_MAX_MESSAGE_BYTES=4096
WS_WRITE_TIMEOUT=10s
# Ping har PONG_WAIT×0.9; javob kelmasa ulanish yopiladi
WS_PONG_WAIT=60s

# --- Kuzatuv -------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://medbron-jaeger:4317
