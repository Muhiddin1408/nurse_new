{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/booking.confirmed.v1.json",
  "title": "booking.confirmed",
  "description": "Bron tasdiqlandi (to'lov tushdi yoki klinikada to'lash rejimi). Eslatmalar rejalashtiriladi, promo redemption qayd etiladi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "booking.confirmed"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "booking"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booking_id",
        "number",
        "client_id",
        "patient_id",
        "doctor_id",
        "clinic_id",
        "slot_id",
        "place",
        "start_at",
        "end_at",
        "payment_mode",
        "payment_id",
        "confirmed_at",
        "money",
        "promo_code"
      ],
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": "string"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "patient_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "clinic_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "slot_id": {
          "type": "string",
          "format": "uuid"
        },
        "place": {
          "type": "string",
          "enum": [
            "clinic",
            "home"
          ]
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "payment_mode": {
          "type": "string",
          "enum": [
            "prepaid",
            "deposit",
            "at_clinic"
          ]
        },
        "payment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "money": {
          "$ref": "#/$defs/money_split"
        },
        "promo_code": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "money_split": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bron yaratilganda pricing-service hisoblagan moliyaviy snapshot (tiyinda).",
      "required": [
        "total_tiyin",
        "platform_fee_tiyin",
        "provider_fee_tiyin",
        "doctor_payout_tiyin",
        "discount_tiyin",
        "discount_borne_by"
      ],
      "properties": {
        "total_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "platform_fee_tiyin": {
          "type": "integer",
          "description": "Chegirmani platforma ko'tarsa manfiy bo'lishi mumkin (marketing xarajati); invariant: total = platform_fee + provider_fee + doctor_payout"
        },
        "provider_fee_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "doctor_payout_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "discount_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "discount_borne_by": {
          "type": "string",
          "enum": [
            "",
            "platform",
            "doctor"
          ]
        }
      }
    }
  }
}
