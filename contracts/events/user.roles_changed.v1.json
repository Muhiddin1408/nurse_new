{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/user.roles_changed.v1.json",
  "title": "user.roles_changed",
  "description": "Foydalanuvchi rollari o'zgardi (doctor/clinic_admin qo'shildi yoki olindi).",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "user.roles_changed"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "user"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "roles",
        "added",
        "removed"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
