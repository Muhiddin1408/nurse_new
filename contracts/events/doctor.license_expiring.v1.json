{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/doctor.license_expiring.v1.json",
  "title": "doctor.license_expiring",
  "description": "Litsenziya muddati 30 kun ichida tugaydi (kunlik cron, bir marta).",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "doctor.license_expiring"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "doctor"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doctor_id",
        "user_id",
        "license_expires_at"
      ],
      "properties": {
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "license_expires_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
