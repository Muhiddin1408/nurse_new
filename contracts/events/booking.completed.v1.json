{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/booking.completed.v1.json",
  "title": "booking.completed",
  "description": "Qabul yakunlandi. Billing payout'ga qo'shadi, review-service sharh qoldirishga ruxsat beradi, pricing follow-up/paket hisobini yuritadi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "booking.completed"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "booking"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booking_id",
        "number",
        "client_id",
        "patient_id",
        "doctor_id",
        "clinic_id",
        "slot_id",
        "place",
        "start_at",
        "end_at",
        "completed_at",
        "completed_by",
        "payment_mode",
        "paid_tiyin",
        "money",
        "items"
      ],
      "properties": {
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": "string"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "patient_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "clinic_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "slot_id": {
          "type": "string",
          "format": "uuid"
        },
        "place": {
          "type": "string",
          "enum": [
            "clinic",
            "home"
          ]
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_by": {
          "type": "string",
          "enum": [
            "client",
            "doctor",
            "clinic_admin",
            "admin",
            "system"
          ]
        },
        "payment_mode": {
          "type": "string",
          "enum": [
            "prepaid",
            "deposit",
            "at_clinic"
          ]
        },
        "paid_tiyin": {
          "type": "integer",
          "minimum": 0,
          "description": "tiyin (1 so'm = 100 tiyin)"
        },
        "money": {
          "$ref": "#/$defs/money_split"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/booking_item"
          }
        }
      }
    }
  },
  "$defs": {
    "booking_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "service_name",
        "price_tiyin",
        "duration_minutes"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "format": "uuid"
        },
        "service_name": {
          "type": "string",
          "minLength": 1
        },
        "price_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "money_split": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bron yaratilganda pricing-service hisoblagan moliyaviy snapshot (tiyinda).",
      "required": [
        "total_tiyin",
        "platform_fee_tiyin",
        "provider_fee_tiyin",
        "doctor_payout_tiyin",
        "discount_tiyin",
        "discount_borne_by"
      ],
      "properties": {
        "total_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "platform_fee_tiyin": {
          "type": "integer",
          "description": "Chegirmani platforma ko'tarsa manfiy bo'lishi mumkin (marketing xarajati); invariant: total = platform_fee + provider_fee + doctor_payout"
        },
        "provider_fee_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "doctor_payout_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "discount_tiyin": {
          "type": "integer",
          "minimum": 0
        },
        "discount_borne_by": {
          "type": "string",
          "enum": [
            "",
            "platform",
            "doctor"
          ]
        }
      }
    }
  }
}
