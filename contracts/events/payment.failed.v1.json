{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/payment.failed.v1.json",
  "title": "payment.failed",
  "description": "To'lov amalga oshmadi (provayder rad etdi yoki muddati o'tdi). Bron payment_due_at gacha qayta to'lash imkonini saqlaydi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "payment.failed"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "payment"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_id",
        "booking_id",
        "client_id",
        "provider",
        "reason"
      ],
      "properties": {
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "booking_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "type": "string",
          "enum": [
            "payme",
            "click",
            "cash"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
