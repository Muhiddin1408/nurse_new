{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/affiliation.paused.v1.json",
  "title": "affiliation.paused",
  "description": "Klinika shifokor bilan hamkorlikni vaqtincha to'xtatdi: kelajakdagi bo'sh slotlar yopiladi, mavjud bronlar SAQLANADI.",
