        "affiliation_id",
        "clinic_id",
        "doctor_id",
        "paused_by"
      ],
      "properties": {
        "affiliation_id": {
          "type": "string",
          "format": "uuid"
        },
        "clinic_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "paused_by": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
