{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/affiliation.ended.v1.json",
  "title": "affiliation.ended",
  "description": "Shifokor–klinika aloqasi tugadi (rad etildi, to'xtatildi yoki shifokor chiqib ketdi). Klinikadagi bo'sh slotlar bloklanadi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "affiliation.ended"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "affiliation"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affiliation_id",
        "clinic_id",
        "doctor_id",
        "ended_by",
        "status"
      ],
      "properties": {
        "affiliation_id": {
          "type": "string",
          "format": "uuid"
        },
        "clinic_id": {
          "type": "string",
          "format": "uuid"
        },
        "doctor_id": {
          "type": "string",
          "format": "uuid"
        },
        "ended_by": {
          "type": "string",
          "enum": [
            "clinic",
            "doctor",
            "admin"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "declined",
            "ended",
            "left",
            "suspended"
          ],
          "description": "declined — shifokor taklifni rad etdi; ended — klinika tugatdi; left — shifokor chiqdi; suspended — admin klinika/shifokorni to'xtatdi"
        }
      }
    }
  }
}
