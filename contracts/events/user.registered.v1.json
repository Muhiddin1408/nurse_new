{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.medbron.uz/events/user.registered.v1.json",
  "title": "user.registered",
  "description": "Telefon OTP orqali birinchi marta tasdiqlandi — yangi foydalanuvchi.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    }
  ],
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "aggregate_type",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "user.registered"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "user"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "phone",
        "registered_at"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "phone": {
          "type": "string"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
